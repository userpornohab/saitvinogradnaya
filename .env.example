# Backend FastAPI settings
SECRET_KEY=change-this-secret-key-before-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./data/database.db

# Telegram booking bot settings
TELEGRAM_BOT_TOKEN=1234567890:replace_with_real_token
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_MANAGER_CHAT_ID=123456789
# Optional, for servers where Telegram API is unavailable directly
TELEGRAM_API_PROXY=

# Guest accounts: production uses HTTPS; configure SMTP before registration
PUBLIC_SITE_URL=https://vinegrape.ru
GUEST_COOKIE_SECURE=true
GUEST_ALLOWED_ORIGINS=https://vinegrape.ru
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false
SMTP_STARTTLS=true

# Robokassa: use separate test/live passwords; never expose these to Vue
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_TEST_PASSWORD1=
ROBOKASSA_TEST_PASSWORD2=
ROBOKASSA_IS_TEST=true
ROBOKASSA_HASH=sha256
ROBOKASSA_RECEIPT_ENABLED=true
# Ask your accountant which VAT rate applies; no tax regime is assumed
ROBOKASSA_TAX=
# Optional: otherwise use the merchant account's tax regime
ROBOKASSA_SNO=

# Frontend public settings used during local development/build if needed
VUE_APP_API_URL=https://api.vinegrape.ru
VUE_APP_TELEGRAM_BOT=your_bot_username
